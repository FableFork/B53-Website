# ── CMS (/admin) ─────────────────────────────────────────────
# Password for the /admin control panel. Required.
ADMIN_PASSWORD=

# Fine-grained GitHub personal access token with "Contents: Read and write"
# permission on the B53-Website repo. Required in production.
GITHUB_TOKEN=

# Repo + branch the CMS commits to. Vercel deploys from this branch.
GITHUB_REPO=FableFork/B53-Website
GITHUB_BRANCH=master

# Set to "true" in local dev to edit files on disk directly (instant
# preview with `next dev`, no commits). Leave unset on Vercel.
# CMS_LOCAL=true

# ── Existing ─────────────────────────────────────────────────
# Notion inbound database for the contact form (already configured on Vercel)
NOTION_INBOUND_DB=
NOTION_TOKEN=
